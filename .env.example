# Copy to .env (git-ignored) or set as CI secrets / variables. Every value is optional for the
# default local run; set only what an environment needs. Never commit real values.

# Environment and target
ENV=qa
BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:8081/api

# Accounts of the application under test (CI secrets in real environments)
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# Database access (leave empty where the environment does not allow it: DB tests are skipped)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Browser and execution
BROWSER=chrome
HEADLESS=true
EXECUTION=local
GRID_URL=http://localhost:4444

# Orchestration
PARALLEL=classes
THREADS=2
RETRY_COUNT=1
