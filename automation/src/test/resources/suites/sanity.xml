<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Sanity: the key happy paths and role checks after a deployment.
    Parallel mode and threads come from configuration (-Dparallel, -Dthreads), not from this file.
-->
<suite name="Sanity">
    <listeners>
        <listener class-name="com.enterprise.automation.listeners.ExecutionSettingsListener"/>
        <listener class-name="com.enterprise.automation.listeners.RetryTransformer"/>
        <listener class-name="com.enterprise.automation.listeners.TestLogContextListener"/>
        <listener class-name="com.enterprise.automation.listeners.FailureDiagnosticsListener"/>
        <listener class-name="com.enterprise.automation.listeners.ExecutionMetadataListener"/>
        <listener class-name="com.enterprise.automation.tests.base.DemoAppLifecycle"/>
    </listeners>
    <test name="Sanity">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <packages>
            <package name="com.enterprise.automation.tests.*"/>
        </packages>
    </test>
</suite>
