<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Default suite. Milestone 7 splits it into smoke / regression / api / ui / integration / e2e suites. -->
<suite name="Enterprise Test Automation">
    <listeners>
        <!-- Starts the application under test for env=local -->
        <listener class-name="com.enterprise.automation.tests.base.DemoAppLifecycle"/>
    </listeners>
    <test name="Foundation">
        <packages>
            <package name="com.enterprise.automation.tests.foundation"/>
        </packages>
    </test>
    <test name="Platform">
        <packages>
            <package name="com.enterprise.automation.tests.platform"/>
        </packages>
    </test>
    <test name="API">
        <packages>
            <package name="com.enterprise.automation.tests.api"/>
        </packages>
    </test>
    <test name="UI">
        <packages>
            <package name="com.enterprise.automation.tests.ui"/>
        </packages>
    </test>
    <test name="E2E">
        <packages>
            <package name="com.enterprise.automation.tests.e2e"/>
        </packages>
    </test>
</suite>
