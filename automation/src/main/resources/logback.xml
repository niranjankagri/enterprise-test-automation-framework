<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging for framework and tests.

    Console: INFO and above, short format, for people watching a run.
    File:    DEBUG and above, with the thread name, for investigating a failure afterwards.
             The thread name matters once tests run in parallel (Milestone 7).
-->
<configuration>
    <property name="LOG_DIR" value="${log.dir:-target/logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/automation.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Our own code: full detail -->
    <logger name="com.enterprise" level="DEBUG"/>

    <!-- Third-party libraries are noisy at DEBUG; keep them at WARN -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
