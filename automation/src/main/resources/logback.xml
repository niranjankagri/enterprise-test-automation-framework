<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging for framework and tests.

    Every line: time, level, thread, test, component (UI, API, DB...) and the message, secrets masked.
    Console: INFO and above, for people watching a run.
    File:    DEBUG and above, plus the logger name, for investigating a failure afterwards.
-->
<configuration>
    <!-- %maskedMsg: the message with passwords, tokens and other secrets replaced by **** -->
    <conversionRule conversionWord="maskedMsg" class="com.enterprise.automation.reporting.MaskingConverter"/>
    <!-- %component: the framework layer that logged (UI, API, DB, DRIVER, CONFIG, DATA, TEST, APP...) -->
    <conversionRule conversionWord="component" class="com.enterprise.automation.reporting.ComponentConverter"/>

    <property name="LOG_DIR" value="${log.dir:-target/logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [%X{test:--}] [%component] %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/automation.log</file>
        <append>false</append>
        <encoder>
            <!-- %X{test}: the test that wrote the line (set by TestLogContextListener), essential in parallel runs -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{test:--}] [%component] %logger{36} - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <!-- Per-test log for the report (Allure attachment "Test log"), our own code only -->
    <appender name="TEST_LOG" class="com.enterprise.automation.reporting.TestLogAppender"/>

    <!-- Our own code: full detail -->
    <logger name="com.enterprise" level="DEBUG">
        <appender-ref ref="TEST_LOG"/>
    </logger>

    <!-- Third-party libraries are noisy at DEBUG; keep them at WARN -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
